generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model agent_group_tools {
  agent_group_id String       @db.Uuid
  tool_id        String       @db.Uuid
  is_allowed     Boolean      @default(true)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  agent_groups   agent_groups @relation(fields: [agent_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tools          tools        @relation(fields: [tool_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([agent_group_id, tool_id])
  @@schema("public")
}

model agent_groups {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String                @unique @db.VarChar(100)
  name                String                @db.VarChar(255)
  description         String?
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  agent_group_tools   agent_group_tools[]
  agent_submodules    agent_submodules[]
  conversations       conversations[]
  generated_artifacts generated_artifacts[]
  service_tokens      service_tokens[]
  session_contexts    session_contexts[]
  tool_call_logs      tool_call_logs[]
  user_agent_access   user_agent_access[]

  @@schema("public")
}

model agent_submodules {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_group_id String       @db.Uuid
  code           String       @unique @db.VarChar(100)
  name           String       @db.VarChar(255)
  description    String?
  is_active      Boolean      @default(true)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  agent_groups   agent_groups @relation(fields: [agent_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model analytics_snapshots {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshot_date      DateTime     @db.Date
  department_id      String?      @db.Uuid
  position_id        String?      @db.Uuid
  completion_rate    Decimal?     @db.Decimal(5, 2)
  avg_score          Decimal?     @db.Decimal(5, 2)
  satisfaction_score Decimal?     @db.Decimal(5, 2)
  dropout_rate       Decimal?     @db.Decimal(5, 2)
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  departments        departments? @relation(fields: [department_id], references: [id], onUpdate: NoAction)
  positions          positions?   @relation(fields: [position_id], references: [id], onUpdate: NoAction)

  @@unique([snapshot_date, department_id, position_id])
  @@schema("public")
}

model auth_sessions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String?
  ip_address         String?   @db.Inet
  user_agent         String?
  expired_at         DateTime? @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model backend_api_catalog {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String           @unique @db.VarChar(120)
  name           String           @db.VarChar(255)
  http_method    String           @db.VarChar(10)
  path           String           @db.VarChar(500)
  description    String?
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  tool_call_logs tool_call_logs[]
  tools          tools[]

  @@schema("public")
}

model company_policies {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String     @unique @db.VarChar(120)
  title          String     @db.VarChar(255)
  category       String     @db.VarChar(100)
  document_id    String?    @db.Uuid
  version_label  String?    @db.VarChar(50)
  effective_date DateTime?  @db.Date
  is_active      Boolean    @default(true)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @default(now()) @db.Timestamptz(6)
  documents      documents? @relation(fields: [document_id], references: [id], onUpdate: NoAction)

  @@schema("public")
}

model contacts_directory {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String       @db.VarChar(255)
  department_id String?      @db.Uuid
  role_title    String?      @db.VarChar(255)
  email         String?      @db.Citext
  phone         String?      @db.VarChar(50)
  support_type  String?      @db.VarChar(100)
  is_active     Boolean      @default(true)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @default(now()) @db.Timestamptz(6)
  departments   departments? @relation(fields: [department_id], references: [id], onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model conversations {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String           @db.Uuid
  agent_group_id String?          @db.Uuid
  channel        String           @default("webchat") @db.VarChar(50)
  session_key    String           @db.VarChar(255)
  status         String           @default("open") @db.VarChar(30)
  started_at     DateTime         @default(now()) @db.Timestamptz(6)
  ended_at       DateTime?        @db.Timestamptz(6)
  agent_groups   agent_groups?    @relation(fields: [agent_group_id], references: [id], onUpdate: NoAction)
  users          users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages       messages[]
  tool_call_logs tool_call_logs[]

  @@unique([user_id, session_key])
  @@index([agent_group_id], map: "idx_conversations_agent_group_id")
  @@index([user_id], map: "idx_conversations_user_id")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model course_prerequisites {
  course_id                                                    String  @db.Uuid
  prerequisite_course_id                                       String  @db.Uuid
  courses_course_prerequisites_course_idTocourses              courses @relation("course_prerequisites_course_idTocourses", fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courses_course_prerequisites_prerequisite_course_idTocourses courses @relation("course_prerequisites_prerequisite_course_idTocourses", fields: [prerequisite_course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([course_id, prerequisite_course_id])
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model course_skills {
  course_id     String  @db.Uuid
  skill_id      String  @db.Uuid
  outcome_level Int     @default(1)
  courses       courses @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skills        skills  @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([course_id, skill_id])
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model courses {
  id                                                                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                                                                      String                 @unique @db.VarChar(100)
  title                                                                     String                 @db.VarChar(255)
  description                                                               String?
  category                                                                  String?                @db.VarChar(100)
  level_no                                                                  Int                    @default(1)
  duration_hours                                                            Decimal                @default(0) @db.Decimal(8, 2)
  format                                                                    String                 @default("self_paced") @db.VarChar(50)
  content_document_id                                                       String?                @db.Uuid
  is_active                                                                 Boolean                @default(true)
  created_at                                                                DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                                                                DateTime               @default(now()) @db.Timestamptz(6)
  course_prerequisites_course_prerequisites_course_idTocourses              course_prerequisites[] @relation("course_prerequisites_course_idTocourses")
  course_prerequisites_course_prerequisites_prerequisite_course_idTocourses course_prerequisites[] @relation("course_prerequisites_prerequisite_course_idTocourses")
  course_skills                                                             course_skills[]
  documents                                                                 documents?             @relation(fields: [content_document_id], references: [id], onUpdate: NoAction)
  learning_path_items                                                       learning_path_items[]
  quiz_templates                                                            quiz_templates[]
  training_feedback                                                         training_feedback[]
  training_sessions                                                         training_sessions[]
  user_courses                                                              user_courses[]

  @@schema("public")
}

model departments {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String                @unique @db.VarChar(50)
  name                String                @db.VarChar(255)
  description         String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  analytics_snapshots analytics_snapshots[]
  contacts_directory  contacts_directory[]
  learning_paths      learning_paths[]
  onboarding_plans    onboarding_plans[]
  users               users[]

  @@schema("public")
}

model document_permissions {
  document_id String    @db.Uuid
  role_id     String    @db.Uuid
  can_view    Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  documents   documents @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles       roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([document_id, role_id])
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model documents {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String?                @unique @db.VarChar(120)
  title                String                 @db.VarChar(255)
  category             String                 @db.VarChar(100)
  group_code           String?                @db.VarChar(100)
  source_type          String                 @default("file") @db.VarChar(30)
  file_path            String?
  mime_type            String?                @db.VarChar(120)
  content_text         String?
  content_json         Json?
  version_no           Int                    @default(1)
  is_active            Boolean                @default(true)
  created_by           String?                @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  company_policies     company_policies[]
  courses              courses[]
  document_permissions document_permissions[]
  users                users?                 @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  onboarding_tasks     onboarding_tasks[]

  @@index([category], map: "idx_documents_category")
  @@index([content_json], map: "idx_documents_content_json_gin", type: Gin)
  @@index([group_code], map: "idx_documents_group_code")
  @@schema("public")
}

model faq_items {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category   String   @db.VarChar(100)
  audience   String   @default("all") @db.VarChar(100)
  question   String
  answer     String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model generated_artifacts {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?       @db.Uuid
